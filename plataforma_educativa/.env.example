# Plataforma Educativa (escuela.maxocracia.com) — ejemplo de configuración.
# Copia este archivo a `.env` (ignorado por git) y ajusta los valores.
# run.py lo carga automáticamente si python-dotenv está instalado.

# Clave de sesión/HMAC propia de ESTE nodo. Sin definir, se usa la del entorno
# del proceso. Genera una con: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Clave dedicada de firma de JWT para la federación con start.
# Debe tener el MISMO valor que JWT_SECRET_KEY en el .env de Maxocracia.
# Ver config.example.env (sección JWT) para el rollout de JWT_KEY_SEPARATION=1.
JWT_SECRET_KEY=

# Rotación de la clave de firma: durante la transición, la clave ANTERIOR
# sigue aceptándose como gracia para no cortar sesiones vigentes.
# JWT_SECRET_KEY_PREVIOUS=

# Funda el rol de coordinador en una BD vacía desde la puerta pública.
# Sin esto (y sin petición local), el primer registro por el túnel NO es
# coordinador: una BD recreada no le entrega el mando al primero que llegue.
# PLATAFORMA_EDUCATIVA_BOOTSTRAP_TOKEN=

# Servidor (defaults seguros: localhost, puerto 5050, sin debugger)
# PLATAFORMA_EDUCATIVA_HOST=127.0.0.1
# PLATAFORMA_EDUCATIVA_PORT=5050
# PLATAFORMA_EDUCATIVA_DEBUG=0

# Vida útil de los tokens locales en memoria, en segundos (default 30 días).
# PLATAFORMA_EDUCATIVA_TOKEN_TTL=2592000

# Rate limit de login/registro
# AUTH_RATE_LIMIT_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW=60

# Actividad en terminal (lenguaje natural): por defecto activo.
# LOG_HUMANO=0 lo silencia; LOG_METRICAS_CADA resume cada N peticiones.
# LOG_HUMANO=1
# LOG_METRICAS_CADA=100
