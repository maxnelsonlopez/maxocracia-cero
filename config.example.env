# ============================================
# ConfiguraciÃ³n de Maxocracia - Variables de Entorno
# ============================================
# Copia este archivo a .env y actualiza los valores
# NUNCA subas .env a Git (ya estÃ¡ en .gitignore)
# Autor: Kimi (Moonshot AI)
# ============================================

# --------------------------------------------
# ConfiguraciÃ³n General
# --------------------------------------------
SECRET_KEY=tu-clave-secreta-muy-larga-y-aleatoria-aqui
# Genera 32+ bytes: openssl rand -hex 32 (obligatorio en produccion)
FLASK_ENV=development
PORT=5001

# --------------------------------------------
# Stripe - ConfiguraciÃ³n de Pagos
# --------------------------------------------
# Crear cuenta en https://stripe.com
# Ver guÃ­a completa en: docs/GUIA_CONFIGURACION_STRIPE.md

# Modo Test (desarrollo)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Modo Live (producciÃ³n) - ACTIVAR CUANDO TODO ESTÃ‰ PROBADO
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# IDs de Precios (obtener del Dashboard de Stripe â†’ Productos)
STRIPE_PRICE_CONTRIBUTOR=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# IDs de Productos (opcional, para customer portal)
STRIPE_PRODUCT_CONTRIBUTOR=prod_...
STRIPE_PRODUCT_ENTERPRISE=prod_...

# URLs de RedirecciÃ³n despuÃ©s de checkout
CHECKOUT_SUCCESS_URL=http://localhost:3000/upgrade?success=true
CHECKOUT_CANCEL_URL=http://localhost:3000/upgrade?canceled=true

# --------------------------------------------
# Base de Datos
# --------------------------------------------
# SQLite (desarrollo)
DATABASE_URL=sqlite:///comun.db

# PostgreSQL (producciÃ³n - opcional)
# DATABASE_URL=postgresql://user:password@localhost/maxocracia

# --------------------------------------------
# JWT (Autenticación)
# --------------------------------------------
JWT_SECRET_KEY=tu-jwt-secret-diferente-al-secret-key
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800
# Separación de claves (recomendada): con JWT_KEY_SEPARATION=1 los JWT se
# firman con JWT_SECRET_KEY (y no con SECRET_KEY de sesión/HMAC). Para migrar
# sin cortar la federación con la escuela:
#   1) define la MISMA JWT_SECRET_KEY en start y en el entorno de la escuela;
#      reinicia la escuela (sigue aceptando tokens firmados con SECRET_KEY).
#   2) pon JWT_KEY_SEPARATION=1 en start y reinicia.
# Rollback: quita el flag y reinicia start.
JWT_KEY_SEPARATION=0

# --------------------------------------------
# Email (opcional - para notificaciones)
# --------------------------------------------
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=tu-email@gmail.com
# SMTP_PASSWORD=tu-app-password
# FROM_EMAIL=noreply@maxocracia.org
# FROM_NAME=Maxocracia

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
FORCE_HTTPS=0
# Con FORCE_HTTPS=1 (produccion detras de proxy TLS) toda peticion
# http se redirige 308 a https segun X-Forwarded-Proto.
TRUST_PROXY=0
# Con TRUST_PROXY=1 se confia en UN salto de proxy (cloudflared): la IP real
# via X-Forwarded-For/X-Forwarded-Proto alimenta rate limiting y HSTS.
# NO activar si el backend queda expuesto directo (permite falsificar la IP).
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# --------------------------------------------
# Frontend URL (para CORS)
# --------------------------------------------
FRONTEND_URL=http://localhost:3000

# --------------------------------------------
# Modo Testing
# --------------------------------------------
TESTING=False
# --------------------------------------------
# Oráculo Sintético en Vivo (DeepSeek, protocolo OpenAI-compatible)
# --------------------------------------------
# Sin API key el oráculo queda deshabilitado con degradación elegante:
# los endpoints de negociación responden 503 y la validación heurística
# sigue funcionando. Documentado en docs/architecture/ROADMAP_oraculo_vivo_y_escalas.md
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ORACLE_ENABLED=true
# DEEPSEEK_TIMEOUT=120

# ============================================
# CHECK-IN DE BIENESTAR (Ola 4, Puente A)
# ============================================
# Política asimétrica: las CAÍDAS de γ se escuchan siempre (INV1, Ternura);
# las MEJORAS siguen un ritmo mínimo entre latidos. Ventana en días para
# las mejoras (default 7). Una oleada de migración masiva puede requerir
# un ritmo más denso: reducir el valor por despliegue, sin tocar código.
# MAXO_CHECKIN_WINDOW_DAYS=7

# ============================================
# INSTRUCCIONES
# ============================================
# 1. Copiar este archivo: cp config.example.env .env
# 2. Generar SECRET_KEY: openssl rand -hex 32
# 3. Configurar Stripe (ver docs/GUIA_CONFIGURACION_STRIPE.md)
# 4. Actualizar FRONTEND_URL si es diferente
# 5. Reiniciar servidor para cargar cambios
# ============================================

# ============================================
# Concilio - Motores LLM gratuitos (multi-proveedor)
# ============================================
# Registro: maxocontracts/oracles/engines.py (cadena: openrouter -> nvidia -> deepseek -> local;
# OpenRouter principal desde 15-09-2026 hasta recargar DeepSeek - ver CONCILIO_ENGINE_ORDER)
# La clave JAMAS va a Git: solo se configura en .env
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4-flash-0731
# Alternativas del tenant: deepseek-ai/deepseek-v4-pro-0813 (misma familia, contexto 1M),
# nvidia/nemotron-3-super-120b-a12b (262K), moonshotai/kimi-k3 (familia distinta)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_SITE_URL=https://localhost/maxocracia
# OPENROUTER_APP_TITLE=Maxocracia-Concilio
# --- Ritmo del Concilio en cuota free (20 req/min; 50/dia sin creditos, 1000/dia con 10+) ---
# CONCILIO_ENGINE_ORDER=openrouter,nvidia,deepseek
# CONCILIO_PAUSA_SEGUNDOS=4
# CONCILIO_AUTOSTART_GAP_HOURS=12

# --------------------------------------------
# Logging JSON sanitizado (plan seguridad, 30-90 dias)
# LOG_JSON=1 activa logs en JSON con secretos redactados
# (tokens, claves API, gamma/ESI de protegidos - nunca su contenido).
# El limiter lee RATELIMIT_STORAGE_URI (o REDIS_URL) - ver app/limiter.py
LOG_JSON=0
